# ========================================
# Deep Search API v2.0 - Configuration
# ========================================

# REQUIRED: Google API Configuration
GOOGLE_API_KEY=your_google_api_key_here

# Cache Configuration
CACHE_ENABLED=true
CACHE_DIR=./cache
CACHE_TTL=86400  # 24 hours in seconds
CACHE_MAX_SIZE_MB=2000  # 2GB for 16GB RAM machine

# Playwright Browser Configuration
PLAYWRIGHT_TIMEOUT=30  # seconds, max 60
MAX_BROWSERS=4  # Concurrent browser instances

# Search Configuration
SEARCH_TIMEOUT=30  # seconds, total timeout per search
RERANKER_USE_CLOUD=true  # Try Google Gemini first

# Chunking Configuration
CHUNKING_STRATEGY=hybrid  # markdown, semantic, or hybrid
CHUNK_SIZE=350  # Target tokens per chunk

# Debug Mode
DEBUG=false