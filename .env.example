# ==============================================================================
# rAI Search API Stack - Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your values.

# ------------------------------------------------------------------------------
# 1. AUTHENTICATION & API KEYS
# ------------------------------------------------------------------------------
# Required for Google Gemini (Embeddings, Reranking, Synthesis)
GOOGLE_API_KEY=your_google_api_key_here

# Required ONLY if using OpenAI synthesis provider
OPENAI_API_KEY=

# Required ONLY if using Z.ai synthesis provider
ZAI_API_KEY=

# ------------------------------------------------------------------------------
# 2. SYNTHESIS PROVIDER SETTINGS
# ------------------------------------------------------------------------------
# Choose provider: gemini (default), openai, or zai
SYNTHESIS_PROVIDER=gemini

# Model selection for each provider
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini
ZAI_MODEL=glm-4.7-flash
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/

# ------------------------------------------------------------------------------
# 3. PERFORMANCE & RESOURCE LIMITS
# ------------------------------------------------------------------------------
# Browser scaling (memory intensive)
MAX_BROWSERS=4
PLAYWRIGHT_TIMEOUT=30

# Content extraction (CPU intensive)
EXTRACTION_WORKERS=4
EXTRACTION_MAX_IN_FLIGHT=8
EXTRACTION_POOL_RECYCLE_TASKS=500

# Global search timeout
SEARCH_TIMEOUT=30

# API rate limiting
RATE_LIMIT=30/minute

# ------------------------------------------------------------------------------
# 4. CACHE SETTINGS
# ------------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_DIR=./cache
CACHE_TTL=86400
CACHE_MAX_SIZE_MB=2000

# ------------------------------------------------------------------------------
# 5. RAG & RERANKING CONFIGURATION
# ------------------------------------------------------------------------------
# Chunking: markdown, semantic, or hybrid
CHUNKING_STRATEGY=hybrid
CHUNK_SIZE=350

# Reranking: set false to use local cross-encoder only
RERANKER_USE_CLOUD=true

# ------------------------------------------------------------------------------
# 6. INFRASTRUCTURE & LOGGING
# ------------------------------------------------------------------------------
DEBUG=false